# Copy to .env and fill in. Every variable here is declared in
# packages/contracts/src/env.ts — add it there first, or verify will not see it.

# Postgres connection string. Neon, Supabase, or a local instance.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/keel"

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app.
BETTER_AUTH_URL="http://localhost:3000"
