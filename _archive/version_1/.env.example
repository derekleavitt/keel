# Copy to .env and fill in. Every variable here is declared in
# packages/contracts/src/env.ts — add it there first, or verify will not see it.

# Postgres connection string. Neon, Supabase, or a local instance.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/keel"

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app.
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret for POST /api/jobs/run, used by whatever calls the worker on a timer.
# Generate one with: openssl rand -base64 32
JOBS_SECRET=""

# Let webhook endpoints point at localhost and private addresses.
# Development only — the environment contract refuses this in production, because it
# disables the guard that stops a tenant aiming a webhook at cloud metadata.
WEBHOOK_ALLOW_PRIVATE_HOSTS=1

# Turn off the auth rate limiter, so a test suite that signs up per test is not throttled.
# Development only — the environment contract refuses this on a deployed instance, where it
# would leave the sign-in endpoint an unmetered password-guessing oracle.
AUTH_RATE_LIMIT_DISABLED=1
